# Copy to .env.local for local dev. In Vercel, set these in Project → Settings → Environment Variables.
# Nothing here is required for the landing-page deploy yet — all optional until the
# corresponding integrations are wired (see roadmap.txt).

# Public site URL (used for metadata / OG tags / canonical).
# On Vercel this falls back to the deployment URL automatically; set it to the
# custom domain once you have one.
NEXT_PUBLIC_APP_URL=

# --- Clerk (auth) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Keep auth flows returning to the landing page (also set on <ClerkProvider>).
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/

# --- PostHog (analytics) — not wired yet ---
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Sentry — not wired yet ---
# SENTRY_AUTH_TOKEN=
# NEXT_PUBLIC_SENTRY_DSN=
