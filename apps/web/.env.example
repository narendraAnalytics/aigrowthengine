# Local dev: copy to `.env` (git-ignored). Production/Preview: set these in
# Vercel → Project → Settings → Environment Variables. Never commit real values.
#
# Schema + validation: src/env.ts (@t3-oss/env-nextjs). A missing REQUIRED var
# fails `next build`. Optional vars are only format-checked when present.

# --- Clerk (auth) --- REQUIRED
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Keep auth flows returning to the landing page (also set on <ClerkProvider>).
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/

# --- Neon Postgres --- REQUIRED
# Pooled connection string from the Neon dashboard (…-pooler.…neon.tech).
DATABASE_URL=

# --- Public site URL --- optional
# Falls back to the Vercel deployment URL automatically. Set to the custom
# domain once you have one.
NEXT_PUBLIC_APP_URL=

# --- FastAPI service (Phase 1.5) --- optional
API_BASE_URL=

# --- PostHog (Phase 2 / Track 3) --- optional
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Sentry (Phase 1.7) --- optional (CI-only; NEXT_PUBLIC_SENTRY_DSN added in 1.7)
SENTRY_AUTH_TOKEN=
