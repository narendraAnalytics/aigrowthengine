# Local dev: copy to `.env` (git-ignored). Prod: set in the host's secret manager.

# Neon Postgres. A plain postgresql:// URL is fine — config.py rewrites it to the
# asyncpg driver and translates sslmode=require. Uses the same Neon database as
# the web app for now (Phase 1.5 skeleton; /readyz only runs SELECT 1).
DATABASE_URL=

# dev | staging | prod  (prod hides /docs)
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Extra browser origins allowed to call the API (localhost:3000 is always on;
# *.vercel.app is matched by regex). Comma-separated or JSON list.
# CORS_ORIGINS=["https://aigrowthengine.vercel.app"]

# RATE_LIMIT_DEFAULT=60/minute

# --- Groq (LLM) --- required from Phase 3 (assessment engine)
# Key: console.groq.com -> API Keys. See docs/adr/0001-ai-provider-groq.md.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m

# --- Sentry --- optional (SDK no-ops until SENTRY_DSN is set)
# Use a Python/FastAPI Sentry project (separate from the web one). DSN from
# project -> Settings -> Client Keys (DSN).
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_RELEASE=  (git SHA — set by CI / the deploy)
